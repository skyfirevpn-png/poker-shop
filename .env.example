# --- HitPay (payment gateway, FPX etc.) ---
# From HitPay dashboard > Payment Gateway > API Keys
HITPAY_API_KEY=your_hitpay_api_key
# From HitPay dashboard > Payment Gateway > Webhook, or generated when you save a webhook URL
HITPAY_WEBHOOK_SALT=your_hitpay_webhook_salt
# https://api.hitpayapp.com for live, https://api.sandbox.hitpayapp.com for sandbox/testing
HITPAY_API_BASE=https://api.sandbox.hitpayapp.com

# --- Telegram bot (order notifications) ---
# Create a bot via @BotFather, get the token it gives you
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Message @userinfobot (or your bot) to get your numeric chat id
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Site ---
# Your deployed site URL (used for redirect_url after payment). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-shop.vercel.app
